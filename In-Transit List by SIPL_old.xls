	tr.redrow td { background-color: #f3e3e3 !important; }
	tr.redrow td input { background-color: #f3e3e3 !important; border: 1px solid #dccbcb !important;  margin-bottom: 0px; vertical-align: top;}
	tr.redrow td select { background-color: #f3e3e3 !important; border: 1px solid #dccbcb !important; height: 24px; font-size: 11px; margin-bottom: 0px;}
	tr.redrow td textarea { background-color: #f3e3e3 !important; border: 1px solid #dccbcb !important; height: 24px; font-size: 11px; margin-bottom: 0px;}
	.tbl_redrow { border-top: 1px solid #d8c9c9 !important; border: 0; }
	#listInTransitTable tbody tr td { border: none !important; }
	tr.greenrow td { background-color:#bbfad8 !important; }
	tr.greenrow td input { background-color: #bbfad8 !important; border: 1px solid #dccbcb !important;  margin-bottom: 0px; vertical-align: top;}
	tr.greenrow td select { background-color: #bbfad8 !important; border: 1px solid #dccbcb !important; height: 24px; font-size: 11px; margin-bottom: 0px;}
	tr.greenrow td textarea { background-color:#bbfad8 !important; border: 1px solid #dccbcb !important; height: 24px; font-size: 11px; margin-bottom: 0px;}
	.tbl_greenrow { border-top: 1px solid #d8c9c9 !important; border: 0; }
	#listInTransitTable tbody tr td { border: none !important; }
	.etadates .ui-datepicker-trigger { margin-bottom: 0 !important; }
</style>

<script language="javascript" >
	$("input[kind='date']").datepicker({ numberOfMonths: 2, showButtonPanel: true,  showOn: "both", buttonImage: "image/icon_calendar.gif", buttonImageOnly: true});
	$("#dbLocation").select2();
   $("#dbPurchaseLocation").select2();
	$("#dbTransactionStatus").select2();
	$("#dbTransactionStage").select2();
	$("#dbItemID").select2({
		minimumInputLength: 3,
		query: function (query) {
			var rdata = {results: []}
			$.get('../../cPurchaseFromMulPOs.aspx?act=getProducts', {"SearchTerm":query.term}, function(data){
				console.log(data);
				rdata.results = $.parseJSON(data);
				console.log(rdata);
				query.callback(rdata);
				 
			});  
		}
	});
	if(0 > 0)
	$('#dbItemID').select2('data', {id: 0, text: ""});
	function SaveField(obj,count)
	{
		var Ids;
		Ids =  $('#row_'+ count).val();
		Ids = Ids.split(",");
		$.post("listInTransitBySIPL.aspx?act=save&field="+ obj.name +"&id="+ Ids[0]+"&id2="+Ids[1] +"&THeaderAdditionalID="+ Ids[2]+"&t="+ new Date().getTime(),{"val":obj.value} ,function(data){
		$('#'+ obj.name +'_'+ count).removeClass('hide');
			
		});
	}

	function CopyDown(previousid, currentid, column, rowcnt)
	{
		console.log('#'+column+'_'+previousid)
		var value = $('#'+column+'_'+previousid).val();
		$('#'+ column+'_'+currentid).val((value!= '' ? value :''));
		saveFieldsOnCopyDown(currentid, ''+column, value, rowcnt);
	}

	function saveFieldsOnCopyDown(currentID, objname, value, rowcnt)
	{		
		var Ids;
		Ids =  $('#row_'+ rowcnt).val();
		Ids = Ids.split(",");
		console.log(Ids +","+ objname +","+ value)
		$.post("listInTransitBySIPL.aspx?act=save&field="+ objname +"&id="+ Ids[0]+"&id2="+Ids[1]  +"&THeaderAdditionalID="+ Ids[2]+"&t="+ new Date().getTime(), {"val":value},function(data){
			$('#'+ objname +'_'+ rowcnt).removeClass('hide');
		});				
	}

	function SaveLineField(obj,LineID)
	{
		$.post("listInTransitBySIPL.aspx?act=save&field="+ obj.name +"&val="+ encodeURIComponent(obj.value) +"&lid="+LineID, function(data){
			$('#img'+ obj.name +'_'+ LineID).removeClass('hide');
		});
	}

	//added this function to send the parameters in query string - Manju 2/28/2015
	document.getElementById("dbItemID").focus();
	function submitForm(){
		var PortETA = document.getElementById("dbPortETA").checked ? 'on' : 'off';
		var Select2Data
		if($('#dbItemID').select2('data') != null)
		{
			Select2Data = $('#dbItemID').select2('data').text;
				
		}
		else
		{
			Select2Data=''
		}
		location.href="listInTransitBySIPL.aspx?list=listInTransitBySIPL&tab=&sort=&order=&searchBy=&searchOperator=&dbSearchValue1=&dbSearchValue2=&q8="+$('#dbItemID').val()+"&q9="+$("#dbTransactionNumber").val()+"&q10="+$("#dbLocation").val()+"&q11="+$("#dbETADate").val()+"&q12="+$("#dbPortETADate").val()+"&q13="+ $("#dbContainerNumber").val().replace(/&/g,"***") +"&q14="+($("#dbSupplierName").val()).replace("#","%23")+"&q15="+($("#dbVessel").val()).replace("#","%23")+"&q16="+$("#dbTransactionStatus").val()+"&q17="+($("#dbTransactionStage").val()).replace("#","%23")+"&q18="+$("#dbLFD").val()+"&q19="+PortETA+"&q20="+Select2Data+"&q21="+$("#dbDischargeDate").val()+"&q22="+$("#dbPurchaseLocation").val()
	}
	
	function ExpandRows(PurchaseID, colorrow)
	{
		var src = ($('#mainrow_'+PurchaseID+ ' img').attr("src") === 'image/icon_plus.gif')
            ? 'image/icon_minus.gif'
            : 'image/icon_plus.gif';
        $('#mainrow_'+PurchaseID+ ' img').attr('src', src);
		if (document.getElementById("rowInner_"+PurchaseID).innerHTML != "")
		{
			$('#rowInner_'+PurchaseID).html("");
			$('#rowInner_'+PurchaseID).hide();
		}
		else
		{
			$('#ajax-loadingV1').center().show();
			$.get('listInTransitBySIPL.aspx?act=getItemDetails&SIPLID='+ PurchaseID +'&rowcolor='+ colorrow +'&z=' + new Date().getTime(), function(data){
			$('#rowInner_'+PurchaseID).show();
			$('#rowInner_'+PurchaseID).html(data);
			$('#ajax-loadingV1').center().hide();
			});
		}
		return false;
	}

	function clearsel(){if($('#dbItemID').select2('data') !=''){$('#dbItemID').select2('data',"");} }
 </script>

 