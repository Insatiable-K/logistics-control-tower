<div ID="ajax-loadingV1" class='absolute ajax-loader' style='display: none;z-index:103;'><img src='image/loadingV1.gif'></div>
<style type="text/css">
	.ajax-loader {
		position: absolute;
		left: 50%;
		top: 50%;
		margin-left: -32px; /* -1 * image width / 2 */
		margin-top: -32px;  /* -1 * image height / 2 */
		display: block;     
	}
	.well 
	{
	  min-height: 20px;
	  padding: 15px;
	  margin-top: -8px;
	  margin-bottom: 15px;
	  background-color: #f5f5f5;
	  border: 1px solid #eee;
	  border: 1px solid rgba(0, 0, 0, 0.05);
	  -webkit-border-radius: 4px;
	  -moz-border-radius: 4px;
	  border-radius: 4px;
	  -webkit-box-shadow: inset 0 1px 1px rgba(0, 0, 0, 0.05);
	  -moz-box-shadow: inset 0 1px 1px rgba(0, 0, 0, 0.05);
	  box-shadow: inset 0 1px 1px rgba(0, 0, 0, 0.05);
	}
	#tdSearchValue1_listInTransit .ui-datepicker-trigger { margin-bottom: -3px !important;}
	#listInTransitTable .ui-datepicker-trigger { margin-bottom: -5px !important;}
	tr.siplrow1 td { background-color: #D8D8D8 !important; }
	tr.siplrow1 td input { background-color: #D8D8D8 !important; border: 1px solid #bbbaba !important;  margin-bottom: 0px; vertical-align: top;}
