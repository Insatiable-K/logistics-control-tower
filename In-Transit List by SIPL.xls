	tr.siplrow2 td { background-color: rgb(241, 241, 241) !important; }
	tr.siplrow2 td input { background-color: rgb(241, 241, 241) !important; border: 1px solid #ccc !important; margin-bottom: 0px; vertical-align: top;}
	tr.siplrow2 td select { background-color: rgb(241, 241, 241) !important; height: 24px; font-size: 11px; margin-bottom: 0px;}
