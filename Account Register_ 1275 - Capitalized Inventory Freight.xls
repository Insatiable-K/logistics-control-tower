<script type="text/javascript">
var VoidType="";
var IsClosed="";
var reconcileid=0;
$("#AccountID").select2();
function getAccount(obj){
location.href = "R_AccountRegister.aspx?q="+ obj.value + "&q1=11/01/2025&q2=&q3=&q4=&q8=";
}

function ShowMenu(TID){
	$.post("R_AccountRegister.aspx?act=getPaymentInfo&ID="+ TID +"&q=529", function(data){
		var data1 = data.split("###");
		VoidType = data1[0];
		reconcileid= data1[1];
		IsClosed = data1[2];
		if (VoidType == "VOID Child")
		{
			return false;
		}
		else{
			$('#dropdown-EventOpt').text("");
			var q = "529&q1=11/01/2025&q2=&q3=&q4=&q5=&q7=&q8=";
			$('#dropdown-EventOpt').append("<ul style='background-color:#fcf8ef;border-radius:0px;padding-top:0px;width:120px'><li class='hand' style='padding:0px;border-bottom:1px solid #b2b8c1;line-height: 13px;'><a style='text-align:left;padding:9px;padding-right:3px;line-height: 15px;font-family: Arial;font-size:10pt;' class='moderate' ID='UpdatePayment' data-load='cQuickPayLayer.aspx?ID="+ TID +"&q="+ q +"' data-toggle='modal' role='button' data-width='570' OnClick='UpdatePayment(this);'>Update Payment</a></li><li class='hand' style='padding:0px;border-bottom:1px solid #b2b8c1;line-height: 13px;'><a style='text-align:left;padding:9px;font-family: Arial;font-size:10pt;line-height: 15px;' OnClick='DeletePayment("+ TID +");'>Delete Payment</a></li><li class='hand' style='padding:0px;border-bottom:1px solid #b2b8c1;line-height: 13px;'><a style='text-align:left;padding:9px;font-family: Arial;font-size:10pt;line-height: 15px;' href='vTransaction.aspx?ID="+ TID +"' target='_blank'>View Detail</a></li></ul>");
		}
	});
}

$("#dropdown-EventOpt").on("click", "a", function () {
	$("#dropdown-EventOpt").hide();		
});
document.addEventListener('click', function(e){
if(e.target.id!=="#dropdown-EventOpt")
    $("#dropdown-EventOpt").hide();
});

function UpdatePayment(obj){
	if ("False" == "False")
	{
		alert("You don't have permission to update payment. Please contact your accounts admin.");
		return false;
	}
	else if (VoidType=="VOID Parent")
	{
		alert("This payment is already voided and cannot be updated.");
		VoidType="";
		return false;
	}
	else if (IsClosed=="True")
	{
		alert("This payment is in a closed period. Please open the period in order to make any changes.");
		IsClosed="";
		return false;
	}
	else if (reconcileid > 0)
	{
		alert("This payment is reconciled. You have to unreconcile the payment in order to update it.");
		return false;
	}
	else{
		$('#ajax-loading').center().show();
		$.get($(obj).attr('data-load'), {'z':new Date().getTime()}, function(data){
			  $('<div class="modal" role="dialog" aria-labelledby="myModalLabel"  style="width:570px;">' + data + '</div>').modal({backdrop: false});					
		});
	}
}
function DeletePayment(TID){
	if ("False" == "False")
	{
		alert("You don't have permission to delete payment. Please contact your accounts admin.");
		return false;
	}
	else if (VoidType=="VOID Parent")
	{
		alert("This payment is already voided and cannot be deleted.");
		VoidType="";
		return false;
	}
	else if (IsClosed=="True")
	{
		alert("This payment is in a closed period. Please open the period to delete the payment.");
		IsClosed="";
		return false;
	}
	else if (reconcileid > 0)
	{
		alert("This payment is reconciled. You have to unreconcile the payment in order to delete it.");
		return false;
	}
	else{
		var confirmed = confirm("This action will delete both payment and related bill. Click OK to continue?")
		if (confirmed)
		{
			$.post("cQuickPayLayer.aspx?act=Delete&ID="+TID,function(data){
				alert(data)
				location.href="R_AccountRegister.aspx?q=529&q1=11/01/2025&q2=&q3=&q4=&q8=";
			});
		}
	}
}
</script>
<style type="text/css">
.dropdown1-menu LI {
    display: block;
    color: #555;
    text-decoration: none;
    line-height: 13px;
    padding: 3px 15px;
    white-space: nowrap;
	}
	.dropdown1-menu.has-tip {
    margin-top: -3px;
    
}
	.Trebuchet{font-family: Trebuchet MS;}
	.dropdown1-menu.has-tip:before {
    position: absolute;
    top: -7px;
    left: 9px;
    content: '';
    border-left: 7px solid transparent;
    border-right: 7px solid transparent;
    border-bottom: 7px solid;
    border-bottom-color: #CCC;
    display: inline-block;
}
Pseudo ::after element
.dropdown1-menu.has-tip.anchor-right:after {
    left: auto;
    right: 10px;
}
.dropdown1-menu.has-tip:after {
    position: absolute;
    top: -5px;
    left: 10px;
    content: '';
    border-left: 6px solid transparent;
    border-right: 6px solid transparent;
    border-bottom: 6px solid #fcf8ef;
    display: inline-block;
}
.dropdown1-menu LI>A, .dropdown1-menu LABEL {
    display: block;
    color: #555;
    text-decoration: none;
    line-height: 15px;
    padding: 3px 15px;
    white-space: nowrap;
    /*width: 93px;*/
}
.dropdown1-menu LI>A, .dropdown1-menu LABEL {
    display: block;
    color: #555;
    text-decoration: none;
    padding: 3px 0px;
    white-space: nowrap;
}
.dropdown1-menu UL {
    min-width: 60px;
    list-style: none;
    background: #FFF;
    border: solid 1px #DDD;
    border: solid 1px rgba(0,0,0,.2);
    border-radius: 0px;
    overflow: visible;
    padding: 0px 0;
    margin: 0;
}

.dropdown1-menu
{
	font:14px sans-serif;
	position: absolute;
	z-index:9999999; 
}

.dropdown1-menu ul,
.dropdown1-menu li,
.dropdown1-menu span,
.dropdown1-menu a {
  margin: 0;
  padding: 0;
  position: relative;
}
.dropdown1-menu {
  line-height: 13px !important;
  border-radius: 0px 0px 0 0;
  -moz-border-radius: 0px 0px 0 0;
  -webkit-border-radius: 0px 0px 0 0;
  
  width: auto;
}
.dropdown1-menu:after,
.dropdown1-menu ul:after {
  content: '';
  display: block;
  clear: both;
}
.dropdown1-menu a {
  background:none;
  color: #555;
  display: block;
  font-family: Helvetica, Arial, Verdana, sans-serif;
  padding: 19px 20px;
  text-decoration: none;
}
.dropdown1-menu ul {
  list-style: none;
}
.dropdown1-menu > ul > li {
  display: inline-block;
  float: left;
  margin: 0;
  width:100%;
}
.dropdown1-menu.align-center {
  text-align: center;
}
.dropdown1-menu.align-center > ul > li {
  float: none;
}
.dropdown1-menu.align-center ul ul {
  text-align: left;
}
.dropdown1-menu.align-right > ul {
  float: right;
}
.dropdown1-menu.align-right ul ul {
  text-align: right;
}
.dropdown1-menu > ul > li > a {
  color: #555;
  font-size: 12px;
}
.dropdown1-menu > ul > li:hover:after {
  content: '';
  display: block;
  width: 100%;
  height: 0;
  position: absolute;
  left: 50%;
  bottom: 0;
  border-left: 10px solid transparent;
  border-right: 10px solid transparent;
  border-bottom: none;
  margin-left: -10px;
}
.dropdown1-menu > ul > li:first-child > a {
  border-radius: 0px 0 0 0;
  -moz-border-radius: 0px 0 0 0;
  -webkit-border-radius: 0px 0 0 0;
}
.dropdown1-menu.align-right > ul > li:first-child > a,
.dropdown1-menu.align-center > ul > li:first-child > a {
  border-radius: 0;
  -moz-border-radius: 0;
  -webkit-border-radius: 0;
}
.dropdown1-menu.align-right > ul > li:last-child > a {
  border-radius: 0 0px 0 0;
  -moz-border-radius: 0 0px 0 0;
  -webkit-border-radius: 0 0px 0 0;
}
.dropdown1-menu > ul > li.active > a,
.dropdown1-menu > ul > li:hover > a {
  color: #ffffff;
  background: #328cd1;
}
.dropdown1-menu .has-sub {
  z-index: 1;
}
.dropdown1-menu .has-sub:hover > ul {
  display: block;
}
.dropdown1-menu .has-sub ul {
  display: none;
  position: absolute;
  min-width: 57px;
  top: 100%;
  left: 0;
}
.dropdown1-menu.align-right .has-sub ul {
  left: auto;
  right: 0;
}
.dropdown1-menu .has-sub ul li {
  *margin-bottom: -1px;
}
.dropdown1-menu .has-sub ul li a {
  background: #fcf8ef;
  border-bottom: none;
  font-size: 11px;
  filter: none;
  display: block;
  line-height: 15px !important;
  padding: 10px;
  color: #555;
}


.dropdown1-menu .has-sub :hover > ul {
  display: block;
}
.dropdown1-menu .has-sub ul {
  display: none;
  position: absolute;
  left: 100%;
  top: 0;
}
.dropdown1-menu.align-right .has-sub  ul,
.dropdown1-menu.align-right ul ul ul {
  left: auto;
  right: 100%;
}
.dropdown1-menu .has-sub ul li a {
  background: #fcf8ef;
  border-bottom: none;
}
.dropdown1-menu .has-sub ul li a:hover {
  background: black;
  color: #fcf8ef;
}
.dropdown1-menu ul ul li.last > a,
.dropdown1-menu ul ul li:last-child > a,
.dropdown1-menu ul ul ul li.last > a,
.dropdown1-menu ul ul ul li:last-child > a,
.dropdown1-menu .has-sub ul li:last-child > a,
.dropdown1-menu .has-sub ul li.last > a {
  border-bottom: 0;
}
.table td { font-size: 12px ; }
.table th { font-size: 13px !important; }

html *
{ font-family: Roboto !important;  }
</style>
