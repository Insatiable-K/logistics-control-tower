<style type="text/css">
.well {
  min-height: 20px;
  padding: 15px;
  margin-top: -8px;
  margin-bottom: 15px;
  background-color: #f5f5f5;
  border: 1px solid #eee;
  border: 1px solid rgba(0, 0, 0, 0.05);
  -webkit-border-radius: 4px;
  -moz-border-radius: 4px;
  border-radius: 4px;
  -webkit-box-shadow: inset 0 1px 1px rgba(0, 0, 0, 0.05);
  -moz-box-shadow: inset 0 1px 1px rgba(0, 0, 0, 0.05);
  box-shadow: inset 0 1px 1px rgba(0, 0, 0, 0.05);
}

.ui-datepicker-trigger { margin-bottom:-5px !Important }

.ImgWrap{
	width:200px;
	height:100px;
	overflow:hidden;
	position: relative;
	display: inline-block;
}
.ImgWrap img{
	position: absolute;
	Margin-Left:0px;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	max-width:100;
	max-height:100;
}
ui-state-default{
	border: 0px !important;
	background: #ffffff !important;
	font-weight: normal !important;
	font-size: 12px !important;
	padding: 0px !important;
	padding-right: 4px !important;
	color: #555555 !important;
}
.FinishButtons {
	white-space: normal;
	min-height: 31px;
	min-width: 27px;
	height: 100%;
	width: 100%;
	padding-top: 6px;
	font-size: 9pt;
}
.FinishButtons:hover {
	background-color: #eaeaea;
}
.Type{
	width: 100%;
	text-align: left;
	border-color: #ccc;
	margin: 2px;
	height: 35px;
	padding: 8px;
}
.btn-sm {
	font-size: 12px;
	line-height: 1.5;
	border-radius: 3px;
}
.btn {
	display: inline-block;
	font-weight: 400;
	vertical-align: middle;
	cursor: pointer;
	background-image: none;
	border: 1px solid transparent;
	white-space: nowrap;
	box-shadow: inset 0 1px 0 rgb(255 255 255 / 20%), 0 1px 2px rgb(0 0 0 / 5%);
	user-select: none;
